# Copy to .env.private-alpha and fill every blank required value.
# Keep the real file private; it is ignored by Git.
COMPOSE_PROJECT_NAME=hoi4-save-tracker-alpha

POSTGRES_DB=
POSTGRES_USER=
# Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Exact public origin, including https:// and no trailing slash.
HOI4_HTTPS_ORIGIN=
ACME_EMAIL=

PRIVATE_ALPHA_USERNAME=
# Paste the Caddy bcrypt output inside single quotes so $ remains literal.
PRIVATE_ALPHA_PASSWORD_HASH=''

# Opt-in B2 admission/throttling: enable BEFORE external invitations.
# Review docs/external-alpha-admission.md; empty allowlist denies all NEW signups.
HOI4_REGISTRATION_INVITE_ONLY=false
HOI4_REGISTRATION_ALLOWLIST=
HOI4_ABUSE_PROTECTION_ENABLED=false
# Exact controlled proxy IPs / application-network CIDR; NEVER 0.0.0.0/0 or true.
# Empty ignores forwarded headers (safe, but groups traffic behind the proxy).
HOI4_TRUSTED_PROXY_CIDRS=

# B3: real operator-controlled mailbox; blank/invalid displays unavailable.
# A working/tested contact is REQUIRED before external invitations.
HOI4_SUPPORT_EMAIL=

# Optional capacity settings, inherited from docker-compose.yml.
# Defaults below preserve existing application behavior; this is NOT the
# 20-user sizing recommendation. Before invitations, complete the physical
# capacity gate in docs/external-alpha-capacity.md. Its bounded recommendation
# is HOI4_ANALYSIS_RESULTS_MAX_BYTES=2147483648 (2 GiB), subject to that gate.
# Existing deployment values/overrides must be reviewed, not overwritten.
HOI4_ANALYSIS_RESULTS_MAX_BYTES=134217728
HOI4_RECENT_ANALYSES_LIMIT=200
HOI4_SHARED_ANALYSES_LIMIT=1000
HOI4_ANALYSIS_CACHE_ENTRIES=3
HOI4_TRENDS_CACHE_SNAPSHOTS=2048
HOI4_TRENDS_CACHE_BYTES=67108864
HOI4_MAX_UPLOAD_BYTES=268435456
HOI4_MAX_UNCOMPRESSED_BYTES=536870912
HOI4_UPLOAD_TIMEOUT_MS=120000
HOI4_ANALYSIS_TIMEOUT_MS=60000
HOI4_ANALYSIS_HEAP_MB=1024
# Private-alpha intentionally fixes workers=1 and requests=2 in its overlay.
