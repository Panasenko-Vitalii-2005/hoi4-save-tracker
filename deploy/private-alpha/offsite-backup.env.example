# Install as /etc/hoi4-save-tracker/offsite-backup.env with mode 0600.
# Replace every placeholder. Do not copy credentials into this file.
HOI4_OFFSITE_RCLONE_BIN=/usr/local/bin/rclone
HOI4_OFFSITE_RCLONE_CONFIG=/home/replace-with-user/.config/rclone/rclone.conf
HOI4_OFFSITE_RCLONE_REMOTE=replace-with-rclone-remote
HOI4_OFFSITE_BUCKET=replace-with-bucket-name
HOI4_OFFSITE_PREFIX=replace-with-prefix

# Optional overrides; these are the production defaults.
HOI4_OFFSITE_POSTGRES_BACKUP_DIR=/var/backups/hoi4-save-tracker/postgres
HOI4_OFFSITE_ANALYSIS_HISTORY_BACKUP_DIR=/var/backups/hoi4-save-tracker/analysis-history
HOI4_OFFSITE_WORK_DIR=/var/tmp/hoi4-save-tracker-offsite
