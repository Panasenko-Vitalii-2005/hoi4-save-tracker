[Unit]
Description=HoI4 Save Tracker Private Alpha off-site backup replication
After=network-online.target
Wants=network-online.target
OnFailure=hoi4-monitor-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/hoi4-save-tracker/offsite-backup.env
EnvironmentFile=-/etc/hoi4-save-tracker/monitoring.env
ExecStart=/usr/local/sbin/hoi4-save-tracker-offsite-backup
TimeoutStartSec=120min
UMask=0077
NoNewPrivileges=true
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
