[Unit]
Description=HoI4 Save Tracker Private Alpha host health check
After=docker.service network-online.target
Wants=network-online.target
OnFailure=hoi4-monitor-failure@hosthealth.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/hoi4-save-tracker/monitoring.env
ExecStart=/usr/local/sbin/hoi4-save-tracker-host-health
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/hoi4-save-tracker-monitor
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
