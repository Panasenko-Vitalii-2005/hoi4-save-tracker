# Install as /etc/hoi4-save-tracker/monitoring.env with mode 0600 root:root.
# Paste each independent Better Stack heartbeat URL after creating the monitors.
# Leave a value empty until that monitor is ready; the underlying job/check is unaffected.
HOI4_MONITOR_POSTGRES_HEARTBEAT_URL=
HOI4_MONITOR_ANALYSIS_HISTORY_HEARTBEAT_URL=
HOI4_MONITOR_OFFSITE_HEARTBEAT_URL=
HOI4_MONITOR_HOST_HEALTH_HEARTBEAT_URL=

# Host-health inputs. Use absolute production paths; systemd does not expand ~.
HOI4_MONITOR_PROJECT_DIR=/opt/hoi4-save-tracker
HOI4_MONITOR_PRIVATE_ALPHA_ENV_FILE=/opt/hoi4-save-tracker/.env.private-alpha
HOI4_MONITOR_POSTGRES_BACKUP_DIR=/var/backups/hoi4-save-tracker/postgres
HOI4_MONITOR_ANALYSIS_HISTORY_BACKUP_DIR=/var/backups/hoi4-save-tracker/analysis-history

# Fixed production dependencies/state location. Override only after review.
HOI4_MONITOR_CURL_BIN=/usr/bin/curl
HOI4_MONITOR_STATE_DIR=/var/lib/hoi4-save-tracker-monitor
